{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignore": [
    "packages/mobile/android/app/src/main/assets/public/**",
    "packages/mobile/ios/App/App/public/**",
    "packages/sdk/examples/**"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "oxlint.config.ts",
        "oxlint.anti-slop.config.ts",
        "postcss.config.js",
        "scripts/**/*.{js,cjs,mjs,ts}"
      ],
      "project": [
        "*.{js,cjs,mjs,ts}",
        "scripts/**/*.{js,cjs,mjs,ts}"
      ]
    },
    "packages/ui": {
      "entry": [
        "src/**/*.bench.{ts,tsx}",
        "src/**/*.{test,spec}.{js,cjs,mjs,jsx,ts,tsx}",
        "src/**/__tests__/**/*.{js,cjs,mjs,jsx,ts,tsx}",
        // bunfig.toml [test] preload — loaded by bun before every test file, invisible to static analysis.
        "src/test/preload.ts",
        // The shared-page bundle entry: vite-share-document.ts builds it as a standalone IIFE (SHARE_DOCUMENT_ENTRY), not through an import.
        "src/share-document/entry.tsx",
        // Build-time replacements named by string path in shims.ts (SHARE_DOCUMENT_SHIMS); the vite shim plugin resolves them, never an import.
        "src/share-document/shims/desktop.ts",
        "src/share-document/shims/effective-directory.ts",
        "src/share-document/shims/emoji-picker.ts",
        "src/share-document/shims/extension-block-frame.tsx",
        "src/share-document/shims/extension-blocks.ts",
        "src/share-document/shims/i18n.ts",
        "src/share-document/shims/markdown.tsx",
        "src/share-document/shims/ui-store.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "packages/web": {
      "entry": [
        "src/mobile-main.tsx",
        "src/mini-chat-main.tsx",
        "src/main.tsx",
        "src/sw.ts",
        "bin/**/*.{test,spec}.{js,cjs,mjs}",
        "server/**/*.{test,spec}.{js,cjs,mjs}",
        "src/**/*.{test,spec}.{ts,tsx}"
      ],
      "project": [
        "bin/**/*.js",
        "server/**/*.{js,mjs,cjs}",
        "src/**/*.{ts,tsx}"
      ]
    },
    "packages/electron": {
      "entry": [
        "entry.mjs",
        "main.mjs",
        "preload.mjs",
        "browser-panel-preload.cjs",
        "tray.mjs",
        "ssh-manager.mjs",
        "*.{test,spec}.{js,cjs,mjs}",
        "scripts/**/*.{js,cjs,mjs}"
      ],
      "project": [
        "*.{js,cjs,mjs}",
        "scripts/**/*.{js,cjs,mjs}"
      ]
    },
    "packages/sdk": {
      "entry": [
        "src/index.ts",
        "src/ui/index.ts",
        "src/schemas.ts",
        "src/**/*.{test,spec}.ts",
        "scripts/**/*.{test,spec}.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.ts"
      ]
    },
    "packages/agent-contract": {
      "entry": [
        "src/index.ts",
        "src/**/*.{test,spec}.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/agent-service": {
      "entry": [
        "src/index.ts",
        "src/worker/index.ts",
        "src/**/*.{test,spec}.ts",
        "scripts/*.mjs",
        "src/interaction/host-policy.ipc.child.ts",
        // Published as `@openchamber/agent-service/private-protocol` through a package.json export that points at dist/ build output; the Host in packages/web imports the wire contract through it and static analysis cannot follow the built files back to this source.
        "src/supervisor/host-authorization-protocol.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/*.mjs"
      ]
    },
    "packages/mobile": {
      "entry": [
        "scripts/**/*.{js,cjs,mjs,ts}"
      ],
      "project": [
        "scripts/**/*.{js,cjs,mjs,ts}"
      ]
    }
  }
}
