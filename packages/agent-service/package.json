{
  "name": "@openchamber/agent-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./private-protocol": {
      "types": "./src/supervisor/host-authorization-protocol.ts",
      "default": "./dist/supervisor/host-authorization-protocol.js"
    }
