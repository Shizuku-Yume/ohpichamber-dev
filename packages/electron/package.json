{
  "name": "@openchamber/electron",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop runtime for OhPiChamber",
  "author": "OhPiChamber",
  "type": "module",
  "main": "./dist-bundle/entry.mjs",
  "dependencies": {
    "ohpichamber": "workspace:*",
    "electron-context-menu": "^4.1.2",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "node-abi": "^4.40.0"
  },
  "trustedDependencies": [
    "electron"
  ],
  "desktopPrerequisites": [
    "Electron runtime dependencies installed via bun install",
    "Pinned Bun runtime and installed platform OMP/ONNX native artifacts",
    "macOS: Xcode + build tools for notarized packaging",
    "Windows: NSIS installed for installer creation",
    "Linux: native x64 or arm64 host (no cross-arch packaging); FUSE/libfuse2 to run AppImages, or APPIMAGE_EXTRACT_AND_RUN=1"
  ],
  "scripts": {
    "dev": "bun ../../scripts/build-builtin-extensions.mjs && node --import ../web/scripts/register-server-sources.mjs --conditions=openchamber-source ./scripts/electron-dev.mjs",
    "build:web-assets": "node ./scripts/build-web-assets.mjs",
    "build": "bun -e \"process.exit(0)\"",
    "ensure:electron": "node ./scripts/ensure-electron.mjs",
    "prepare:ripgrep": "node ./scripts/prepare-ripgrep.mjs",
    "verify:linux-appimage": "node ./scripts/verify-linux-appimage.mjs",
    "bundle:main": "bun ./scripts/bundle-main.mjs",
    "generate:macos-icon": "node ./scripts/generate-macos-icon-assets.cjs",
    "rebuild:native": "node ./scripts/rebuild-native.mjs",
    "test": "node ./scripts/test.mjs",
    "test:architecture": "node --test ./startup-url-selection.test.mjs ./menu-locales.test.mjs ./scripts/target-architecture.test.mjs ./scripts/package.test.mjs ./scripts/windows-executable.test.mjs ./scripts/verify-linux-appimage.test.mjs ./scripts/verify-update-manifest.test.mjs ./scripts/ensure-electron.test.mjs",
    "test:updater": "node --test ./updater-capability.test.mjs ./updater-channel.test.mjs ./updater-check.test.mjs ./updater-feed.test.mjs ./scripts/finalize-latest-yml.test.mjs ./scripts/updater-e2e-fixture.test.mjs",
    "test:linux-desktop": "node --test ./linux-autostart.test.mjs ./linux-desktop-entry.test.mjs && node ./scripts/smoke-linux-app-discovery.mjs && node ./scripts/smoke-path-open-utils.mjs",
    "updater:e2e:fixture": "node ./scripts/updater-e2e-fixture.mjs",
    "verify:update-manifest": "node ./scripts/verify-update-manifest.mjs",
    "package": "bun run build:web-assets && bun run prepare:ripgrep && bun run prepare:agent-runtime && bun run verify:agent-runtime && bun run bundle:main && bun run rebuild:native && node ./scripts/package.mjs",
    "finalize:latest-yml": "node ./scripts/finalize-latest-yml.mjs",
    "type-check": "node --check ./entry.mjs && node --check ./early-startup.mjs && node --check ./main.mjs && node --check ./preload.mjs && node --check ./browser-panel-preload.cjs",
    "lint": "node -e \"process.exit(0)\"",
    "prepare:agent-runtime": "bun ./scripts/prepare-agent-runtime.mjs",
    "verify:agent-runtime": "node ./scripts/verify-agent-runtime.mjs"
  },
  "build": {
    "appId": "dev.ohpichamber.desktop",
    "productName": "OhPiChamber",
    "asarUnpack": [
      "node_modules/7zip-bin/win/**/*",
      "node_modules/ohpichamber/build/server/built-in-extensions/**/*",
      "node_modules/ohpichamber/build/server/lib/git/credential-helper.js",
      "node_modules/ohpichamber/build/server/lib/git/ssh-wrapper.js",
      "node_modules/ohpichamber/build/server/lib/git/repository-credential-helper.js"
    ],
    "files": [
      "dist-bundle/entry.mjs",
      "dist-bundle/main.mjs",
      "dist-bundle/early-startup.mjs",
      "preload.mjs",
      "browser-panel-preload.cjs",
      "node_modules/ohpichamber/build/**/*",
      "!**/node_modules/**/*.{ts,mts,cts,tsx,map}",
      "!**/node_modules/**/!(LICENSE*|LICENCE*|license*|licence*|License*).md",
      "!**/node_modules/bun-pty{,/**}",
      "!**/node_modules/luxon/{src,build/amd,build/global,build/cjs-browser}{,/**}",
      "!node_modules/ohpichamber/{dist,src,public,test}{,/**}",
      "!node_modules/ohpichamber/scripts/{dev-server-watch.mjs,dev-server-watch.test.mjs,pack-standalone.mjs,postpack.mjs,prepack.mjs,prepare-agent-runtime.mjs}",
      "!node_modules/ohpichamber/*.{html,tgz}",
      "!node_modules/ohpichamber/{tsconfig.json,tsconfig.tsbuildinfo}",
      "!node_modules/ohpichamber/server/**/*.test.js",
      "!**/node_modules/7zip-bin/{linux,mac}{,/**}",
      "!**/node_modules/7zip-bin/!(${os})/**/*",
      "!**/node_modules/7zip-bin/win/!(${arch}){,/**}",
      "!node_modules/node-pty/prebuilds/!(${platform}-${arch}){,/**}",
      "!**/node_modules/@vscode/ripgrep-*{,/**}",
      "!node_modules/ohpichamber/resources/agent-runtime{,/**}"
    ],
    "extraResources": [
      {
        "from": "resources/web-dist",
        "to": "web-dist"
      },
      {
        "from": "resources/icons/icon.ico",
        "to": "icons/icon.ico"
      },
      {
        "from": "resources/icons/icon.png",
        "to": "icons/icon.png"
      },
      {
        "from": "resources/icons/tray",
        "to": "icons/tray"
      },
      {
        "from": "resources/ripgrep",
        "to": "ripgrep"
      },
      {
        "from": "resources/agent-runtime",
        "to": "agent-runtime"
      }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "buildResources": "resources/icons",
      "output": "dist"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "npmRebuild": false,
    "protocols": {
      "name": "OhPiChamber",
      "schemes": [
        "ohpichamber"
      ]
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icons/icon.icns",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "CFBundleIconName": "AppIcon",
        "NSLocalNetworkUsageDescription": "OhPiChamber needs access to devices and services on your local network.",
        "NSAppleEventsUsageDescription": "Lets commands that you or an agent run in OhPiChamber control other apps."
      },
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "notarize": false,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "resources/icons/icon.ico",
      "target": [
        "nsis"
      ],
      "verifyUpdateCodeSignature": false,
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "resources/icons/app-icon.png",
      "executableName": "ohpichamber",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "OhPiChamber",
          "Comment": "Desktop runtime for OhPiChamber",
          "Icon": "ohpichamber",
          "StartupWMClass": "ohpichamber"
        }
      }
    },
    "deb": {
      "afterInstall": "resources/linux/after-install.tpl",
      "afterRemove": "resources/linux/after-remove.tpl"
    },
    "rpm": {
      "afterInstall": "resources/linux/after-install.tpl",
      "afterRemove": "resources/linux/after-remove.tpl"
    },
    "nsis": {
      "include": "resources/installer.nsh",
      "oneClick": true,
      "perMachine": false,
      "installerIcon": "resources/icons/icon.ico",
      "uninstallerIcon": "resources/icons/icon.ico",
      "installerHeaderIcon": "resources/icons/icon.ico"
    },
    "dmg": {
      "sign": false,
      "title": "${productName} ${version}",
      "backgroundColor": "#FFFCF0",
      "iconSize": 100,
      "iconTextSize": 13,
      "window": {
        "width": 540,
        "height": 340
      },
      "contents": [
        {
          "x": 180,
          "y": 140,
          "type": "file"
        },
        {
          "x": 360,
          "y": 140,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "Shizuku-Yume",
      "repo": "ohpichamber"
    }
  },
  "homepage": "https://openchamber.dev"
}
