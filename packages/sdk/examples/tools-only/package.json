{
  "name": "@openchamber/example-tools-only",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "openchamber": {
    "apiVersion": 1,
    "contributes": {
      "panel": {
        "id": "tools-only",
        "name": "Tool Gallery",
        "icon": "tools"
      },
      "tools": [
        {
          "match": "mcp__example_findings",
          "name": "Code review",
          "icon": "search",
          "title": "Review \u00b7 {input.scope}",
          "subtitle": "{output.summary}",
          "output": "table",
          "columns": [
            "severity",
            "file",
            "finding"
          ]
        },
        {
          "match": "mcp__example_checks",
          "name": "Project checks",
          "icon": "checkbox-circle",
          "title": "Checks \u00b7 {input.project}",
          "subtitle": "{output.summary}",
          "output": "table",
          "columns": [
            "check",
            "status",
            "detail"
          ]
        },
        {
          "match": "mcp__*",
          "name": "Tool result",
          "icon": "tools",
          "output": "json"
        }
      ]
    }
  },
  "dependencies": {
    "ohpichamber-sdk": "workspace:*"
  }
}
