+	registry: ModelRegistry,
+	use: { providerId: string; modelId: string; endpoint: string; chat?: boolean },
+): Promise<void> {
+	await authorizeEmbeddingUse(registry, use);
+}
+
+/** Whether `registry` already mediates its credential boundary. */
+export function isMediatedModelRegistry(registry: ModelRegistry): boolean {
+	return mediatedRegistries.has(registry);
+}
+
+/**
+ * The registry a mediated proxy wraps, for existence-only probes that must not
+ * consume a Host authorization: prompt preflight needs to know whether a
+ * credential EXISTS so it can walk the missing-credential fallback chain, while
+ * the authorization itself belongs to the turn's resolution. Returns the input
+ * unchanged when it is not a mediated proxy.
+ */
+export function unmediatedModelRegistry(registry: ModelRegistry): ModelRegistry {
+	// Walk every wrapping layer to the bottom: pool wrappers around mediated
+	// registries (a pooled parent session's memory mint) and the mediation proxy
+	// itself, so a preauthorized resolver mint never authorizes an empty-model
+	// chat use through the inner mediated methods it delegates into. The walk is
+	// unbounded — chains alternate pool/mediation layers one per agent nesting
+	// generation — with a visited set as the cycle guard.
+	let current = registry;
+	const visited = new Set<ModelRegistry>([current]);
+	for (;;) {
+		const poolTarget = scopedRegistryTarget(current);
+		const mediatedTarget = mediationTargets.get(current);
+		const next = poolTarget ?? mediatedTarget;
+		if (next === undefined || visited.has(next)) return current;
+		visited.add(next);
+		current = next;
+	}
+}
+
+/**
+ * `registry` with its entire credential boundary mediated: every method that
+ * returns or mints a credential — `getApiKey`, `getApiKeyForProvider`,
+ * `getApiKeyWithCredentialForProvider`, `getApiKeyAndHeaders`, and `resolver`
+ * — authorizes the exact provider/model/endpoint use before delegating, so a
+ * Host refusal always precedes the credential release, on the initial mint
+ * and inside auth-retry rotation alike.
+ *
+ * The wrapper is a binding proxy, not an `Object.create` shell: registry
+ * methods touch `#private` fields with `this` as the instance, so every
+ * non-credential member is re-bound to the real registry and keeps working
+ * unchanged. Credential methods are overridden rather than delegated, because
+ * a delegated `getApiKeyAndHeaders` would reach the target's unmediated
+ * `getApiKey` internally. `resolver` is rebuilt against the wrapper itself:
+ * the inherited implementation (or a pool proxy's closure) would otherwise
+ * resolve through the unmediated target, and the rebuild preserves the
+ * central a/b/c auth-retry rotation semantics exactly.
+ *
+ * Discovery-time credential use inside `refresh*` methods is intentionally
+ * not mediated: those are catalog infrastructure the registry serves to every
+ * consumer, not session provider use, and they never release a credential to
+ * their caller.
+ */
+export function mediateModelRegistry(registry: ModelRegistry, authorize: AuthorizeModelUse): ModelRegistry {
+	if (mediatedRegistries.has(registry)) return registry;
+	const getApiKey = async (model: Model<Api>, sessionId?: string, options?: { signal?: AbortSignal }) => {
+		await authorizeOrThrow(authorize, { provider: model.provider, id: model.id, baseUrl: model.baseUrl });
+		return registry.getApiKey(model, sessionId, options);
+	};
+	const getApiKeyForProvider = async (provider: string, sessionId?: string, options?: AuthApiKeyOptions) => {
+		await authorizeOrThrow(authorize, { provider, id: options?.modelId ?? "", baseUrl: options?.baseUrl ?? "" });
+		return registry.getApiKeyForProvider(provider, sessionId, options);
+	};
+	const getApiKeyWithCredentialForProvider = async (
+		provider: string,
+		sessionId?: string,
+		options?: AuthApiKeyOptions,
+	) => {
+		await authorizeOrThrow(authorize, { provider, id: options?.modelId ?? "", baseUrl: options?.baseUrl ?? "" });
+		return registry.getApiKeyWithCredentialForProvider(provider, sessionId, options);
+	};
+	const getApiKeyAndHeaders = async (model: Model<Api>) => {
+		await authorizeOrThrow(authorize, { provider: model.provider, id: model.id, baseUrl: model.baseUrl });
+		return registry.getApiKeyAndHeaders(model);
+	};
+	const resolver = ((target: string | ApiKeyResolverModel, optionsOrSessionId?: ApiKeyResolverOptions | string) => {
+		const options = typeof optionsOrSessionId === "string" ? { sessionId: optionsOrSessionId } : optionsOrSessionId;
+		const resolution = { getApiKeyWithCredentialForProvider, authStorage: registry.authStorage };
+		if (typeof target === "string") {
+			return createApiKeyResolver(resolution, target, options);
+		}
+		return createApiKeyResolver(resolution, target.provider, {
+			...options,
+			baseUrl: target.baseUrl,
+			modelId: target.id,
+		});
+	}) as ModelRegistry["resolver"];
+	const overrides: Partial<ModelRegistry> = {
+		getApiKey,
+		getApiKeyForProvider,
+		getApiKeyWithCredentialForProvider,
+		getApiKeyAndHeaders,
+		resolver,
+	};
+	const bound = new Map<PropertyKey, unknown>();
+	const proxy = new Proxy(registry, {
+		get(object, property) {
+			if (Object.hasOwn(overrides, property)) return overrides[property as keyof ModelRegistry];
+			const value: unknown = Reflect.get(object, property, object);
+			if (typeof value !== "function") return value;
+			let method = bound.get(property);
+			if (method === undefined) {
+				method = value.bind(object);
+				bound.set(property, method);
+			}
+			return method;
+		},
+	});
