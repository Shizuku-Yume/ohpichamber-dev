index 0000000000000000000000000000000000000000..29a3cc761b472219815b31d4aab29c27e78c8bb1
--- /dev/null
+++ b/src/config/mediated-model-registry.ts
@@ -0,0 +1,234 @@
+import type { AuthApiKeyOptions } from "@oh-my-pi/pi-ai/auth-storage";
+import type { Api, Model } from "@oh-my-pi/pi-ai/types";
+import { type ApiKeyResolverModel, type ApiKeyResolverOptions, createApiKeyResolver } from "./api-key-resolver";
+import { scopedRegistryTarget } from "./account-pools";
+import type { ModelRegistry } from "./model-registry";
+
+/**
+ * Host mediation hook for provider use. Runs before any credential release:
+ * a rejection refuses the use and no credential is minted. The model shape is
+ * the resolution slice every mint site can supply — a full `Model` satisfies
+ * it structurally, and provider-scoped resolutions synthesize the id/baseUrl
+ * they carry.
+ */
+export type AuthorizeModelUse = (model: {
+	provider: string;
+	id: string;
+	baseUrl?: string;
+	/**
+	 * `"embedding"` for a remote embedding request: memory content derived from
+	 * the workspace transcript leaves for the embedding endpoint, which is a
+	 * provider use distinct from chat resolution and admitted by its own Host
+	 * rule. Absent for chat and every other resolution.
+	 */
+	purpose?: "embedding";
+}) => Promise<void>;
+/**
+ * Host refusal of one provider use. Distinct from credential-absence errors
+ * (`MissingApiKeyError`): the credential may exist, but policy forbids this
+ * use, so candidate loops should treat it as "this candidate is unusable"
+ * while the terminal error must name the refusal rather than telling the user
+ * to configure credentials. Carries the original refusal as `cause`.
+ */
+export class HostModelUseRefusedError extends Error {
+	readonly provider: string;
+	readonly modelId: string;
+	constructor(model: { provider: string; id: string }, cause: unknown) {
+		super(`Host policy refused provider use for ${model.provider}${model.id ? `/${model.id}` : ""}: ${cause instanceof Error ? cause.message : String(cause)}`, { cause });
+		this.name = "HostModelUseRefusedError";
+		this.provider = model.provider;
+		this.modelId = model.id;
+	}
+}
+
+async function authorizeOrThrow(
+	authorize: AuthorizeModelUse,
+	model: { provider: string; id: string; baseUrl?: string; purpose?: "embedding" },
+): Promise<void> {
+	try {
+		await authorize(model);
+	} catch (error) {
+		if (error instanceof HostModelUseRefusedError) throw error;
+		throw new HostModelUseRefusedError(model, error);
+	}
+}
+
+/** Registries already mediated by {@link mediateModelRegistry}; re-wrapping one is a no-op. */
+const mediatedRegistries = new WeakSet<ModelRegistry>();
+const mediationTargets = new WeakMap<ModelRegistry, ModelRegistry>();
+const mediationAuthorizers = new WeakMap<ModelRegistry, AuthorizeModelUse>();
+
+/**
+ * Authorize one remote embedding use against the Host policy of a mediated
+ * registry. Memory embeddings send text derived from the workspace transcript
+ * to the embedding endpoint, so in a mediated session no remote embedding
+ * request may leave without this authorization — regardless of whether the
+ * key comes from the registry, a pinned configuration or the environment.
+ * Throws {@link HostModelUseRefusedError} on refusal; a no-op for an
+ * unmediated registry, where nothing policy-mediated the session to begin
+ * with.
+ */
+export async function authorizeEmbeddingUse(
+	registry: ModelRegistry,
+	use: { providerId: string; modelId: string; endpoint: string; chat?: boolean },
+): Promise<void> {
+	// A pool wrapper delegates into the mediated registry it wraps: walk the
+	// target chain so the authorizer is found through one wrapping layer. A
+	// registry that is mediated-derived but whose authorizer cannot be resolved
+	// fails closed — never silent egress — while a genuinely unmediated CLI
+	// registry stays a no-op.
+	// Classification follows what the chain bottoms out in, not the wrapper
+	// alone: a pool wrapper around a PLAIN registry is genuinely unmediated and
+	// stays a no-op; a pool wrapper around a mediated registry resolves the
+	// mediated target's authorizer; a mediated registry whose authorizer cannot
+	// be resolved fails closed — never silent egress.
+	const poolTarget = scopedRegistryTarget(registry);
+	const bottom = poolTarget ?? registry;
+	let authorize = mediationAuthorizers.get(registry) ?? (poolTarget !== undefined ? mediationAuthorizers.get(poolTarget) : undefined);
+	if (!authorize) {
+		const mediatedInChain = mediatedRegistries.has(registry) || mediationTargets.has(registry) || mediatedRegistries.has(bottom) || mediationTargets.has(bottom);
+		if (mediatedInChain) {
+			throw new HostModelUseRefusedError(
+				{ provider: use.providerId, id: use.modelId },
+				new Error("the mediated registry's authorizer is unreachable"),
+			);
+		}
+		return;
+	}
+	// `chat` marks the memory pipeline's remote extraction LLM: a completion use
+	// admitted by the exact chat tuple rule, not the embedding endpoint rule.
+	await authorizeOrThrow(authorize, {
+		provider: use.providerId,
+		id: use.modelId,
+		baseUrl: use.endpoint,
+		purpose: use.chat === true ? undefined : "embedding",
+	});
+}
+
+/**
+ * Re-authorize an admitted use inside a credential resolver's rotation path:
+ * policy tightening and credential substitution are seen by the Host on every
+ * rotation, exactly like the chat path, while the worker-lifetime cache absorbs
+ * the repeat round-trip when nothing changed. No-op for unmediated registries.
+ */
